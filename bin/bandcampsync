#!/usr/bin/env python


import sys
import argparse
from pathlib import Path
from bandcampsync import version, logger, do_sync
from bandcampsync.config import Config


log = logger.get_logger('run')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(
        prog='bandcampsync',
        description='Syncs media purcahsed on bandcamp.com with a local directory',
    )
    parser.add_argument('-v', '--version', action='store_true',
        help='Displays the bandcampsync version and exits')
    parser.add_argument('-C', '--config', default='',
        help='Path to a TOML config file')
    parser.add_argument('-c', '--cookies', default='',
        help='Path to the cookies file')
    parser.add_argument('-d', '--directory', default='',
        help='Path to the directory to download media to')
    parser.add_argument('-l', '--library-directory', default='',
        help='Path to beets-managed library directory to check for existing albums')
    parser.add_argument('-I', '--ignore-file', default='',
        help='Path to the ignore file')
    parser.add_argument('-i', '--ignore', default='',
        help='A space-delimited list of patterns matching artists to bypass')
    parser.add_argument('-f', '--format', default='',
        help='Media format to download, defaults to "flac"')
    parser.add_argument('-t', '--temp-dir', default='',
        help='Path to use for temporary downloads')
    parser.add_argument('-n', '--notify-url', default='',
        help='URL to notify with a GET request when any new downloads have completed')
    parser.add_argument('-j', '--concurrency', type=int, default=None,
        help='Number of concurrent downloads (default: 1)')
    parser.add_argument('--max-retries', type=int, default=None,
        help='Maximum number of retries for a download (default: 3)')
    parser.add_argument('--retry-wait', type=int, default=None,
        help='Number of seconds to wait between retries (default: 5)')
    args = parser.parse_args()
    if args.version:
        print(f'BandcampSync version: {version}', file=sys.stdout)
        sys.exit(0)

    # Load config file if provided, otherwise use defaults
    if args.config:
        config_path = Path(args.config).resolve()
        if not config_path.is_file():
            raise ValueError(f'Config file does not exist: {config_path}')
        log.info(f'Loading config from "{config_path}"')
        config = Config.from_file(config_path)
    else:
        config = Config()

    # CLI args override config file values
    cookies_file = args.cookies or config.cookies_file
    directory = args.directory or config.directory
    library_dir_str = args.library_directory or config.library_directory
    ignore_file = args.ignore_file or config.ignore_file
    ign_patterns = args.ignore or config.ignore_patterns
    media_format = args.format or config.format
    temp_dir_str = args.temp_dir or config.temp_directory
    notify_url_str = args.notify_url or config.notify_url
    concurrency = args.concurrency if args.concurrency is not None else config.concurrency
    max_retries = args.max_retries if args.max_retries is not None else config.max_retries
    retry_wait = args.retry_wait if args.retry_wait is not None else config.retry_wait

    # Resolve paths
    cookies_path = Path(cookies_file).resolve()
    dir_path = Path(directory).resolve()
    ign_file_path = Path(ignore_file).resolve() if ignore_file else None
    if library_dir_str:
        library_dir = Path(library_dir_str).resolve()
    else:
        library_dir = None

    # Validate
    if not cookies_path.is_file():
        raise ValueError(f'Cookies file does not exist: {cookies_path}')
    if not dir_path.is_dir():
        raise ValueError(f'Directory does not exist: {dir_path}')
    if library_dir and not library_dir.is_dir():
        raise ValueError(f'Library directory does not exist: {library_dir}')
    if ign_patterns:
        log.warning(f'BandcampSync is bypassing: {ign_patterns}')
    if temp_dir_str:
        temp_dir = Path(temp_dir_str).resolve()
        if not temp_dir.is_dir():
            raise ValueError(f'Temporary directory does not exist: {temp_dir}')
    else:
        temp_dir = None
    if notify_url_str:
        notify_url = notify_url_str
        log.info(f'BandcampSync will notify: {notify_url}')
    else:
        notify_url = None
    if concurrency > 1:
        log.info(f'BandcampSync will use {concurrency} concurrent downloads')
    log.info(f'BandcampSync v{version} starting')
    with open(cookies_path, 'rt') as f:
        cookies = f.read().strip()
    log.info(f'Loaded cookies from "{cookies_path}"')
    do_sync(cookies, dir_path, media_format, temp_dir, ign_file_path, ign_patterns, notify_url, concurrency, max_retries, retry_wait, library_dir)
    log.info(f'Done')
