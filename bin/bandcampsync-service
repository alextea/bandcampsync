#!/usr/bin/env python


import os
import signal
from time import sleep
from random import randrange
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo
from pathlib import Path
from bandcampsync import version, logger, do_sync
from bandcampsync.config import Config, DEFAULT_CONFIG_PATH


log = logger.get_logger('service')


class CatchShutdownSignal:

    def __init__(self):
        self.shutdown = False
        signal.signal(signal.SIGINT, self.got_exit_signal)
        signal.signal(signal.SIGTERM, self.got_exit_signal)

    def got_exit_signal(self, *args, **kwargs):
        self.shutdown = True


if __name__ == '__main__':
    # Load config file if available
    config_path = Path(os.getenv('BANDCAMPSYNC_CONFIG', str(DEFAULT_CONFIG_PATH)))
    if config_path.is_file():
        log.info(f'Loading config from "{config_path}"')
        config = Config.from_file(config_path)
    else:
        log.info(f'No config file found at "{config_path}", using environment variables')
        config = Config()

    # Service-specific settings (always from env vars)
    tz_name = os.getenv('TZ', 'UTC')
    run_daily_at_env = os.getenv('RUN_DAILY_AT', '3')
    exit_after_run_env = os.getenv('EXIT_AFTER_RUN', '0')

    # App settings: env vars override config file values
    cookies_path_env = os.getenv('COOKIES_FILE', '')
    ign_file_path_env = os.getenv('IGNORES_FILE', '')
    dir_path_env = os.getenv('DIRECTORY', '')
    media_format_env = os.getenv('FORMAT', '')
    ign_patterns = os.getenv('IGNORE', '') or config.ignore_patterns
    temp_dir_env = os.getenv('TEMP_DIR', '')
    notify_url_env = os.getenv('NOTIFY_URL', '')
    max_retries_env = os.getenv('MAX_RETRIES', '')
    retry_wait_env = os.getenv('RETRY_WAIT', '')
    concurrency_env = os.getenv('CONCURRENCY', '')
    library_dir_env = os.getenv('LIBRARY_DIRECTORY', '')

    cookies_file = cookies_path_env or config.cookies_file
    dir_path_str = dir_path_env or config.directory
    ign_file_path_str = ign_file_path_env or config.ignore_file
    media_format = media_format_env or config.format
    temp_dir_str = temp_dir_env or config.temp_directory
    notify_url_str = notify_url_env or config.notify_url
    library_dir_str = library_dir_env or config.library_directory

    try:
        max_retries = int(max_retries_env) if max_retries_env else config.max_retries
    except (ValueError, TypeError):
        max_retries = config.max_retries
    try:
        retry_wait = int(retry_wait_env) if retry_wait_env else config.retry_wait
    except (ValueError, TypeError):
        retry_wait = config.retry_wait
    try:
        concurrency = int(concurrency_env) if concurrency_env else config.concurrency
    except (ValueError, TypeError):
        concurrency = config.concurrency

    cookies_path = Path(cookies_file).resolve()
    ign_file_path = Path(ign_file_path_str).resolve() if ign_file_path_str else None
    dir_path = Path(dir_path_str).resolve()
    library_dir = Path(library_dir_str).resolve() if library_dir_str else None

    if not cookies_path.is_file():
        raise ValueError(f'Cookies file does not exist: {cookies_path}')
    if not dir_path.is_dir():
        raise ValueError(f'Directory does not exist: {dir_path}')
    if library_dir and not library_dir.is_dir():
        raise ValueError(f'Library directory does not exist: {library_dir}')
    if temp_dir_str:
        temp_dir = Path(temp_dir_str).resolve()
        if not temp_dir.is_dir():
            raise ValueError(f'Temporary directory does not exist: {temp_dir}')
    else:
        temp_dir = None
    if notify_url_str:
        notify_url = notify_url_str.strip()
        log.info(f'BandcampSync will notify: {notify_url}')
    else:
        notify_url = None
    log.info(f'BandcampSync v{version} starting')
    with open(cookies_path, 'rt') as f:
        cookies = f.read().strip()
    log.info(f'Loaded cookies from "{cookies_path}"')
    try:
        tz = ZoneInfo(tz_name)
    except Exception as e:
        raise ValueError(f'Not a valid timezone name: {tz_name}') from e
    try:
        run_daily_at = int(run_daily_at_env)
    except TypeError as e:
        raise ValueError(f'Invalid RUN_DAILY_AT, got: {run_daily_at}') from e
    if not 0 <= run_daily_at <= 23:
        raise ValueError(f'Invalid RUN_DAILY_AT, must be between 0 and 23, got: {run_daily_at}')
    try:
        exit_after_run = int(exit_after_run_env)
    except (ValueError, TypeError):
        exit_after_run = 0
    exit_after_run = True if exit_after_run else False
    time_now = datetime.now(tz).replace(microsecond=0)
    log.info(f'Time now in {tz}: {time_now}')
    log.info(f'Running an initial one-off synchronisation immediately')
    catch_shutdown = CatchShutdownSignal()
    try:
        while not catch_shutdown.shutdown:
            log.info(f'Starting synchronisation')
            do_sync(cookies, dir_path, media_format, temp_dir, ign_file_path, ign_patterns, notify_url, concurrency, max_retries, retry_wait, library_dir)
            random_delay = randrange(0, 3600)
            time_now = datetime.now(tz).replace(microsecond=0)
            time_tomorrow = time_now + timedelta(days=1)
            time_tomorrow = time_tomorrow.replace(hour=run_daily_at, minute=0, second=0, microsecond=0)
            next_sleep = int((time_tomorrow - time_now).total_seconds() + random_delay)
            if exit_after_run:
                log.info(f'Exiting after run')
                break
            log.info(f'Scheduling next run for {time_tomorrow} + {random_delay} second random offset')
            log.info(f'Sleeping for {next_sleep} seconds')
            sleep(next_sleep)
    except KeyboardInterrupt:
        log.error('Caught keyboard interrupt, stopping')
    log.info(f'Done')
